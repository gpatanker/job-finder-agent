# Supabase project settings (Settings > API and Settings > Database in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Settings > Database > Connection string > URI, use the pooled "Transaction" connection for serverless)
DATABASE_URL=

# Anthropic API key, used for answer generation, resume tailoring, and job search
ANTHROPIC_API_KEY=

# Perplexity API key, used for the broad-discovery step of job search (Sonar API)
PERPLEXITY_API_KEY=

# Exa API key (dashboard.exa.ai) — optional. Only needed to run the
# Perplexity-vs-Exa retrieval comparison in
# scripts/compare-search-providers.mts; the live search pipeline still runs
# on Perplexity. New accounts get $20 of free credits, which is far more
# than a few comparison batches cost.
EXA_API_KEY=

# Set to 1 to seed generic demo data locally; never set in production
SEED_DEMO_DATA=0

# Only needed to run tests/e2e/full-flow.spec.ts locally — a real Supabase
# Auth account for this app. Never commit real values.
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=
